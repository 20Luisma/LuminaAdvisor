# Variables de entorno — LuminaAdvisor
# Copiá este archivo como .env y rellenalo con tus valores reales
# NUNCA subas el .env al repositorio

# ── Entorno ──────────────────────────────────────────
APP_ENV=local
APP_NAME=LuminaAdvisor
APP_URL=http://localhost/LuminaAdvisor

# ── Base de datos (si se usa MySQL en Hostinger) ──────
DB_HOST=localhost
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASS=tu_contraseña

# ── IA / API externa (si se integra en el futuro) ─────
GEMINI_API_KEY=tu_clave_aqui
